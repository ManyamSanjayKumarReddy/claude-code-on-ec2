ENVIRONMENT=production
ALLOWED_ORIGINS=https://claude-on-ec2.theskilledguru.com

POSTGRES_USER=storeapp
POSTGRES_PASSWORD=change-me
POSTGRES_DB=storeapp
DATABASE_URL=postgres://storeapp:change-me@db:5432/storeapp

# Cloudflare R2 (S3-compatible) bucket for automated database backups.
# Scope this API token to Object Read & Write on this one bucket only.
R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=your-backups-bucket
R2_ACCESS_KEY_ID=change-me
R2_SECRET_ACCESS_KEY=change-me
